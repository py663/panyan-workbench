@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "登录";
}

<h1>登录工作台</h1>
<p class="sub">用同一个账号，在任何电脑或手机上打开，都能看到你的全部数据。</p>

@if (ViewData["Error"] is string error)
{
    <div class="err">@error</div>
}

<form method="post" asp-controller="Account" asp-action="Login">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

    <label>账号</label>
    <input type="text" name="username" value="@ViewData["Username"]" autocomplete="username" required autofocus />

    <label>密码</label>
    <input type="password" name="password" autocomplete="current-password" required />

    <div class="row">
        <label><input type="checkbox" name="remember" value="true" checked /> 30 天内免登录</label>
        <a href="/Account/Register">注册新账号</a>
    </div>

    <button class="btn" type="submit">登 录</button>
</form>
