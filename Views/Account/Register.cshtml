@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "注册";
}

<h1>注册账号</h1>
<p class="sub">注册后你会得到一份独立的数据，别人登录看不到你的内容。</p>

@if (ViewData["Error"] is string error)
{
    <div class="err">@error</div>
}

<form method="post" asp-controller="Account" asp-action="Register">
    @Html.AntiForgeryToken()

    <label>账号（3 到 32 个字符）</label>
    <input type="text" name="username" value="@ViewData["Username"]" autocomplete="username" required autofocus />

    <label>密码（至少 6 位）</label>
    <input type="password" name="password" autocomplete="new-password" required />

    <label>再输一次密码</label>
    <input type="password" name="confirm" autocomplete="new-password" required />

    <button class="btn" type="submit">注 册 并 进 入</button>

    <div class="row" style="justify-content:center;margin-top:16px">
        <a href="/Account/Login">已有账号，去登录</a>
    </div>
</form>
