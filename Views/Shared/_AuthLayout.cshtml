<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>@ViewData["Title"] · 潘琰工作台</title>
  <style>
    * { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; }
    body {
      font-family: "Songti SC", "SimSun", "Noto Serif SC", serif;
      color: #2f3a33;
      background:
        linear-gradient(rgba(252, 250, 243, .82), rgba(252, 250, 243, .9)),
        url('/site/assets/bamboo-bg.png') center/cover no-repeat fixed;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
    }
    .auth-card {
      width: 100%; max-width: 380px;
      background: rgba(252, 250, 243, .94);
      border: 1px solid #d8e2d5;
      border-radius: 10px;
      padding: 30px 26px 24px;
      box-shadow: 0 10px 30px rgba(47, 74, 58, .10);
    }
    .seal {
      width: 44px; height: 44px; border-radius: 6px;
      background: #2f4a3a; color: #f7f3e8;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; margin-bottom: 14px;
    }
    h1 { font-size: 22px; margin: 0 0 6px; letter-spacing: 2px; color: #24352b; font-weight: 600; }
    .sub { font-size: 12px; color: #7a877f; margin: 0 0 20px; line-height: 1.7; }
    label { display: block; font-size: 12px; color: #5c6b61; margin: 14px 0 6px; }
    input[type=text], input[type=password] {
      width: 100%; padding: 10px 12px; font-size: 14px;
      border: 1px solid #cfdbcd; border-radius: 6px;
      background: #fffdf8; color: #2f3a33;
      font-family: inherit; outline: none;
    }
    input[type=text]:focus, input[type=password]:focus { border-color: #6f8f6a; }
    .btn {
      width: 100%; margin-top: 20px; padding: 11px;
      border: none; border-radius: 6px; cursor: pointer;
      background: #2f4a3a; color: #f7f3e8;
      font-size: 15px; letter-spacing: 3px; font-family: inherit;
    }
    .btn:hover { background: #3d5c48; }
    .row { display: flex; align-items: center; justify-content: space-between; margin-top: 14px; font-size: 12px; color: #6b7a70; }
    .row label { margin: 0; display: flex; align-items: center; gap: 6px; }
    a { color: #3d6b4a; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .err {
      margin: 0 0 6px; padding: 9px 12px; font-size: 13px;
      color: #8a3d33; background: #fbeee9; border: 1px solid #e6c6bb; border-radius: 6px;
    }
    .foot { margin-top: 18px; font-size: 11px; color: #9aa69e; text-align: center; line-height: 1.8; }
    @@media (max-width: 420px) { .auth-card { padding: 24px 20px 20px; } }
  </style>
</head>
<body>
  <div class="auth-card">
    <div class="seal">潘</div>
    @RenderBody()
    <div class="foot">潘琰工作台 · 数据保存在云端数据库<br>同一账号，手机电脑都能看到</div>
  </div>
</body>
</html>
